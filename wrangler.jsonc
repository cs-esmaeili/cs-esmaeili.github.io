// Cloudflare Workers deployment: static assets only.
//
// The site is a Next.js static export (`output: "export"` in next.config.ts),
// so there is no server script. Wrangler uploads `./out` and serves it directly.
// Without this file, `wrangler deploy` runs Cloudflare's automatic project
// configuration, which detects Next.js and tries to migrate the project to
// OpenNext (a server-side runtime) instead of deploying the static export.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cs-esmaeili-github-io",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./out",
    // Serve out/404.html for unknown paths (Next.js exports it).
    "not_found_handling": "404-page"
  }
}

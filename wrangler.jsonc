// Cloudflare Pages configuration (static site).
//
// The site is a Next.js static export (`output: "export"` in next.config.ts),
// so the build output is `./out`. Declaring `pages_build_output_dir` here makes
// the Pages build use it instead of the dashboard setting (which was resolving
// to a nonexistent "export" directory). This file is the source of truth for
// Pages build configuration.
//
// This is a Pages config, not a Workers config: do not add Workers-only keys
// such as `main` or `assets`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cs-esmaeili",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-11-23"
}
